@page "/pharmacist/patients"
@using pharmacy
@inject FRONT.Services.PatientServices PatientService
@inject NavigationManager Navigation
@inject FRONT.Services.AuthServices AuthService
@inject IJSRuntime JSRuntime

<h3>Patients Management</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="bi bi-plus-circle"></i> Add New Patient
    </button>

    <input type="text" class="form-control w-25" placeholder="Search patients..." @bind="SearchTerm" @bind:event="oninput" />
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (filteredPatients == null || !filteredPatients.Any())
{
    <div class="alert alert-info">No patients found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Date of Birth</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var patient in filteredPatients)
                {
                    <tr>
                        <td>@patient.PatientId</td>
                        <td>@patient.FirstName</td>
                        <td>@patient.LastName</td>
                        <td>@patient.DateOfBirth.ToShortDateString()</td>
                        <td>@patient.PhoneNumber</td>
                        <td>@patient.Email</td>
                        <td>
                            <button class="btn btn-sm btn-info me-1" @onclick="() => NavigateToDetails(patient.PatientId)">
                                <i class="bi bi-eye"></i> View
                            </button>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => NavigateToEdit(patient.PatientId)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePatient(patient.PatientId)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Patient> patients = new();
    private List<Patient> filteredPatients = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string _searchTerm = string.Empty;

    private string SearchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            FilterPatients();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
        await LoadPatients();
    }

    private async Task CheckAuthorization()
    {
        var role = await AuthService.GetRole();
        if (role != "Pharmacist")
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadPatients()
    {
        try
        {
            isLoading = true;
            patients = await PatientService.GetPatientsAsync();
            filteredPatients = patients;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading patients: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void FilterPatients()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            filteredPatients = patients;
        }
        else
        {
            filteredPatients = patients.Where(p =>
                p.FirstName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.LastName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
                p.Email.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/pharmacist/patients/create");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/pharmacist/patients/edit/{id}");
    }

    private void NavigateToDetails(int id)
    {
        Navigation.NavigateTo($"/pharmacist/patients/details/{id}");
    }

    private async Task DeletePatient(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this patient?"))
        {
            try
            {
                var success = await PatientService.DeletePatient(id);
                if (success)
                {
                    successMessage = "Patient deleted successfully.";
                    await LoadPatients();
                }
                else
                {
                    errorMessage = "Failed to delete patient.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting patient: {ex.Message}";
            }
        }
    }
}