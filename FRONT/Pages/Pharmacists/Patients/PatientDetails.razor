@page "/pharmacist/patients/details/{id:int}"
@using pharmacy
@inject FRONT.Services.PatientServices PatientService
@inject FRONT.Services.PrescriptionServices PrescriptionService
@inject NavigationManager Navigation
@inject FRONT.Services.AuthServices AuthService

<h3>Patient Details</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (patient == null)
{
    <div class="alert alert-warning">Patient not found.</div>
}
else
{
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5>Patient Information</h5>
                </div>
                <div class="card-body">
                    <p><strong>ID:</strong> @patient.PatientId</p>
                    <p><strong>Name:</strong> @patient.FirstName @patient.LastName</p>
                    <p><strong>Date of Birth:</strong> @patient.DateOfBirth.ToShortDateString()</p>
                    <p><strong>Age:</strong> @CalculateAge(patient.DateOfBirth) years</p>
                    <p><strong>Phone:</strong> @patient.PhoneNumber</p>
                    <p><strong>Email:</strong> @patient.Email</p>
                    <p><strong>Address:</strong> @(string.IsNullOrEmpty(patient.Address) ? "N/A" : patient.Address)</p>

                    <div class="mt-3">
                        <button class="btn btn-warning me-2" @onclick="@(() => Navigation.NavigateTo($"/pharmacist/patients/edit/{patient.PatientId}"))">
                            <i class="bi bi-pencil"></i> Edit Patient
                        </button>
                        <button class="btn btn-secondary" @onclick="@(() => Navigation.NavigateTo("/pharmacist/patients"))">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <h5>Prescriptions</h5>
                    <button class="btn btn-light btn-sm" @onclick="@(() => Navigation.NavigateTo($"/pharmacist/prescriptions/create?patientId={patient.PatientId}"))">
                        <i class="bi bi-plus-circle"></i> New Prescription
                    </button>
                </div>
                <div class="card-body">
                    @if (prescriptionsLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    }
                    else if (prescriptions == null || !prescriptions.Any())
                    {
                        <p class="text-muted">No prescriptions found for this patient.</p>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var prescription in prescriptions)
                            {
                                <a href="/pharmacist/prescriptions/details/@prescription.PrescriptionId" class="list-group-item list-group-item-action">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">Prescription #@prescription.PrescriptionId</h6>
                                        <small>@prescription.PrescriptionDate.ToShortDateString()</small>
                                    </div>
                                    <p class="mb-1">
                                        <span class="badge @GetStatusBadgeClass(prescription.Status)">
                                            @prescription.Status
                                        </span>
                                    </p>
                                    @if (!string.IsNullOrEmpty(prescription.Instructions))
                                    {
                                        <small><strong>Instructions:</strong> @(prescription.Instructions.Length > 60 ? prescription.Instructions.Substring(0, 60) + "..." : prescription.Instructions)</small>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Patient patient;
    private List<Prescription> prescriptions = new();
    private bool isLoading = true;
    private bool prescriptionsLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var role = await AuthService.GetRole();
        if (role != "Pharmacist")
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPatient();
        await LoadPrescriptions();
    }

    private async Task LoadPatient()
    {
        try
        {
            isLoading = true;
            patient = await PatientService.GetPatientAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading patient: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPrescriptions()
    {
        try
        {
            prescriptionsLoading = true;
            prescriptions = await PrescriptionService.GetPrescriptionsByPatientAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading prescriptions: {ex.Message}";
        }
        finally
        {
            prescriptionsLoading = false;
        }
    }

    private int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age)) age--;
        return age;
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Dispensed" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }
}