@page "/pharmacist/dashboard"
@using pharmacy
@inject FRONT.Services.AuthServices AuthService
@inject FRONT.Services.PatientServices PatientService
@inject FRONT.Services.PrescriptionServices PrescriptionService
@inject FRONT.Services.MedicationServices MedicationService
@inject NavigationManager Navigation

<h3>Pharmacist Dashboard</h3>

<div class="row mb-4">
    <div class="col-12">
        <div class="alert alert-info">
            <strong>Welcome, @username!</strong>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Patients</h5>
                    <h2 class="card-text">@patientCount</h2>
                    <button class="btn btn-light btn-sm mt-2" @onclick="NavigateToPatients">
                        View Patients
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Prescriptions</h5>
                    <h2 class="card-text">@prescriptionCount</h2>
                    <button class="btn btn-light btn-sm mt-2" @onclick="NavigateToPrescriptions">
                        View Prescriptions
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Medications</h5>
                    <h2 class="card-text">@medicationCount</h2>
                    <button class="btn btn-light btn-sm mt-2" @onclick="NavigateToMedications">
                        View Medications
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" @onclick="NavigateToCreatePatient">
                            <i class="bi bi-person-plus"></i> Add New Patient
                        </button>
                        <button class="btn btn-success" @onclick="NavigateToCreatePrescription">
                            <i class="bi bi-file-medical"></i> Create Prescription
                        </button>
                        <button class="btn btn-info" @onclick="NavigateToCreateMedication">
                            <i class="bi bi-capsule"></i> Add Medication
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string username = string.Empty;
    private int patientCount = 0;
    private int prescriptionCount = 0;
    private int medicationCount = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var role = await AuthService.GetRole();
        if (role != "Pharmacist")
        {
            Navigation.NavigateTo("/login");
            return;
        }

        username = await AuthService.GetUsername();
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            isLoading = true;

            var patients = await PatientService.GetPatientsAsync();
            patientCount = patients?.Count ?? 0;

            var prescriptions = await PrescriptionService.GetPrescriptionsAsync();
            prescriptionCount = prescriptions?.Count ?? 0;

            var medications = await MedicationService.GetMedicationsAsync();
            medicationCount = medications?.Count ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToPatients()
    {
        Navigation.NavigateTo("/pharmacist/patients");
    }

    private void NavigateToPrescriptions()
    {
        Navigation.NavigateTo("/pharmacist/prescriptions");
    }

    private void NavigateToMedications()
    {
        Navigation.NavigateTo("/pharmacist/medications");
    }

    private void NavigateToCreatePatient()
    {
        Navigation.NavigateTo("/pharmacist/patients/create");
    }

    private void NavigateToCreatePrescription()
    {
        Navigation.NavigateTo("/pharmacist/prescriptions/create");
    }

    private void NavigateToCreateMedication()
    {
        Navigation.NavigateTo("/pharmacist/medications/create");
    }
}