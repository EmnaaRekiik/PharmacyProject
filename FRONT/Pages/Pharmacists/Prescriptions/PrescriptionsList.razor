@page "/pharmacist/prescriptions"
@using pharmacy
@inject FRONT.Services.PrescriptionServices PrescriptionService
@inject NavigationManager Navigation
@inject FRONT.Services.AuthServices AuthService
@inject IJSRuntime JSRuntime

<h3>Prescriptions Management</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="bi bi-plus-circle"></i> Create New Prescription
    </button>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (prescriptions == null || !prescriptions.Any())
{
    <div class="alert alert-info">No prescriptions found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Instructions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prescription in prescriptions)
                {
                    <tr>
                        <td>@prescription.PrescriptionId</td>
                        <td>
                            @if (prescription.Patient != null)
                            {
                                @($"{prescription.Patient.FirstName} {prescription.Patient.LastName}")
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>
                        <td>@prescription.PrescriptionDate.ToShortDateString()</td>
                        <td>
                            <span class="badge @GetStatusBadgeClass(prescription.Status)">
                                @prescription.Status
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(prescription.Instructions))
                            {
                                @(prescription.Instructions.Length > 50 ? prescription.Instructions.Substring(0, 50) + "..." : prescription.Instructions)
                            }
                            else
                            {
                                <span class="text-muted">No instructions</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-info me-1" @onclick="() => NavigateToDetails(prescription.PrescriptionId)">
                                <i class="bi bi-eye"></i> View
                            </button>

                            @* Only show Edit button if NOT dispensed *@
                            @if (prescription.Status != "Dispensed")
                            {
                                <button class="btn btn-sm btn-warning me-1" @onclick="() => NavigateToEdit(prescription.PrescriptionId)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary me-1" disabled title="Cannot edit dispensed prescriptions">
                                    <i class="bi bi-lock"></i> Locked
                                </button>
                            }

                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePrescription(prescription.PrescriptionId)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Prescription> prescriptions;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
        await LoadPrescriptions();
    }

    private async Task CheckAuthorization()
    {
        var role = await AuthService.GetRole();
        if (role != "Pharmacist")
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadPrescriptions()
    {
        try
        {
            isLoading = true;
            prescriptions = await PrescriptionService.GetPrescriptionsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading prescriptions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning text-dark",
            "Dispensed" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/pharmacist/prescriptions/create");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/pharmacist/prescriptions/edit/{id}");
    }

    private void NavigateToDetails(int id)
    {
        Navigation.NavigateTo($"/pharmacist/prescriptions/details/{id}");
    }

    private async Task DeletePrescription(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this prescription?"))
        {
            try
            {
                var success = await PrescriptionService.DeletePrescription(id);
                if (success)
                {
                    successMessage = "Prescription deleted successfully.";
                    await LoadPrescriptions();
                }
                else
                {
                    errorMessage = "Failed to delete prescription.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting prescription: {ex.Message}";
            }
        }
    }
}