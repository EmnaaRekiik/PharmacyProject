@page "/admin/medications"
@using pharmacy
@inject FRONT.Services.MedicationServices MedicationService
@inject NavigationManager Navigation
@inject FRONT.Services.AuthServices AuthService
@inject IJSRuntime JSRuntime

<h3>Medications Management (Admin)</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>
        @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="bi bi-plus-circle me-1"></i> Add New Medication
    </button>

    <div class="d-flex gap-2">
        <input type="text" class="form-control" style="width: 300px;" 
               placeholder="Search medications..." 
               @bind="searchTerm" 
               @bind:event="oninput" />
        
        <select class="form-select" style="width: 150px;" @bind="stockFilter">
            <option value="all">All Stock</option>
            <option value="low">Low Stock (< 10></>)</option>
            <option value="out">Out of Stock</option>
        </select>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (filteredMedications == null || !filteredMedications.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No medications found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Stock Quantity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var medication in filteredMedications)
                {
                    <tr class="@GetRowClass(medication)">
                        <td>@medication.MedicationId</td>
                        <td>@medication.Name</td>
                        <td>@medication.Description</td>
                        <td>$@medication.Price.ToString("F2")</td>
                        <td>
                            <div class="d-flex align-items-center">
                                @medication.StockQuantity
                                @if (medication.StockQuantity < 10)
                                {
                                    <span class="badge bg-warning text-dark ms-2">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Low
                                    </span>
                                }
                                @if (medication.StockQuantity == 0)
                                {
                                    <span class="badge bg-danger ms-2">
                                        <i class="bi bi-x-circle me-1"></i> Out
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-warning" 
                                        @onclick="() => NavigateToEdit(medication.MedicationId)"
                                        title="Edit Medication">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" 
                                        @onclick="() => DeleteMedication(medication.MedicationId)"
                                        title="Delete Medication">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 text-muted">
        <small>
            Showing @filteredMedications.Count of @allMedications.Count medications
            @if (stockFilter != "all")
            {
                <span>(Filtered by: @stockFilter stock)</span>
            }
        </small>
    </div>
}

@code {
    private List<Medication> allMedications = new();
    private List<Medication> filteredMedications = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string searchTerm = string.Empty;
    private string stockFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
        await LoadMedications();
    }

    private async Task CheckAuthorization()
    {
        var role = await AuthService.GetRole();
        if (role != "Admin")
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadMedications()
    {
        try
        {
            isLoading = true;
            allMedications = await MedicationService.GetMedicationsAsync() ?? new List<Medication>();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading medications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        var filtered = allMedications.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            filtered = filtered.Where(m =>
                m.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                (m.Description != null && m.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            );
        }

        // Apply stock filter
        switch (stockFilter)
        {
            case "low":
                filtered = filtered.Where(m => m.StockQuantity < 10 && m.StockQuantity > 0);
                break;
            case "out":
                filtered = filtered.Where(m => m.StockQuantity == 0);
                break;
        }

        filteredMedications = filtered.ToList();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/admin/medications/create");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/admin/medications/edit/{id}");
    }

    private async Task DeleteMedication(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this medication? This action cannot be undone."))
        {
            return;
        }

        try
        {
            var success = await MedicationService.DeleteMedication(id);
            if (success)
            {
                successMessage = "Medication deleted successfully.";
                await LoadMedications();
            }
            else
            {
                errorMessage = "Failed to delete medication.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting medication: {ex.Message}";
        }
    }

    private string GetRowClass(Medication medication)
    {
        if (medication.StockQuantity == 0) return "table-danger";
        if (medication.StockQuantity < 10) return "table-warning";
        return "";
    }
}