@page "/admin/pharmacists"
@using pharmacy
@inject FRONT.Services.PharmacistServices PharmacistService
@inject NavigationManager Navigation
@inject FRONT.Services.AuthServices AuthService

<h3>Pharmacists Management</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" @onclick="@(() => successMessage = string.Empty)"></button>
    </div>
}

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NavigateToCreate">
        <i class="bi bi-plus-circle"></i> Add New Pharmacist
    </button>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (pharmacists == null || !pharmacists.Any())
{
    <div class="alert alert-info">No pharmacists found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Pharmacy Name</th>
                    <th>Pharmacy Name</th>
                    <th>License Number</th>
                    <th>Phone Number</th>
                    
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pharmacist in pharmacists)
                {
                    <tr>
                        <td>@pharmacist.PharmacistId</td>
                        <td>@pharmacist.PharmacistName</td>
                        <td>@pharmacist.PharmacyName</td>
                        <td>@pharmacist.LicenseNumber</td>
                        <td>@pharmacist.PhoneNumber</td>
                        
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => NavigateToEdit(pharmacist.PharmacistId)">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeletePharmacist(pharmacist.PharmacistId)">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Pharmacist> pharmacists;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckAuthorization();
        await LoadPharmacists();
    }

    private async Task CheckAuthorization()
    {
        var role = await AuthService.GetRole();
        if (role != "Admin")
        {
            Navigation.NavigateTo("/login");
        }
    }

    private async Task LoadPharmacists()
    {
        try
        {
            isLoading = true;
            pharmacists = await PharmacistService.GetPharmacistsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading pharmacists: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/admin/pharmacists/create");
    }

    private void NavigateToEdit(int id)
    {
        Navigation.NavigateTo($"/admin/pharmacists/edit/{id}");
    }

    private async Task DeletePharmacist(int id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this pharmacist?"))
        {
            try
            {
                var success = await PharmacistService.DeletePharmacist(id);
                if (success)
                {
                    successMessage = "Pharmacist deleted successfully.";
                    await LoadPharmacists();
                }
                else
                {
                    errorMessage = "Failed to delete pharmacist.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error deleting pharmacist: {ex.Message}";
            }
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }
}