@page "/admin/profile"
@inject FRONT.Services.AuthServices AuthService
@inject NavigationManager Navigation

<h3>Admin Profile</h3>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Profile Information</h5>
            </div>
            <div class="card-body">
                @if (isLoading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Username</label>
                                <div class="form-control-plaintext">
                                    <strong>@username</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Role</label>
                                <div class="form-control-plaintext">
                                    <span class="badge bg-success">@role</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">User ID</label>
                                <div class="form-control-plaintext">
                                    <code>@userId</code>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Account Created</label>
                                <div class="form-control-plaintext">
                                    <!-- You can add creation date if available -->
                                    <i class="bi bi-clock-history me-1"></i> N/A
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <h5 class="mb-3">Update Profile</h5>
                    <EditForm Model="@updateDto" OnValidSubmit="@HandleUpdate">
                        <DataAnnotationsValidator />

                        @if (!string.IsNullOrEmpty(updateMessage))
                        {
                            <div class="alert @(updateSuccess ? "alert-success" : "alert-danger")">
                                <i class="bi @(updateSuccess ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
                                @updateMessage
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Email Address</label>
                                    <InputText class="form-control" @bind-Value="updateDto.Email" placeholder="Enter email address" />
                                    <small class="text-muted">Your primary email for notifications</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Phone Number</label>
                                    <InputText class="form-control" @bind-Value="updateDto.PhoneNumber" placeholder="Enter phone number" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <InputText class="form-control" @bind-Value="updateDto.FullName" placeholder="Enter your full name" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Address</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="updateDto.Address" placeholder="Enter your address" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" disabled="@isUpdating">
                                @if (isUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Updating...</span>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle me-2"></i>
                                    <span>Update Profile</span>
                                }
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="ResetForm">
                                <i class="bi bi-arrow-clockwise me-2"></i>
                                Reset
                            </button>
                        </div>
                    </EditForm>

                    <hr class="my-4" />

                    <!-- Password Change Section -->
                    <h5 class="mb-3">Change Password</h5>
                    <div class="alert alert-warning">
                        <i class="bi bi-shield-lock me-2"></i>
                        <strong>Security Notice:</strong> Password changes require additional verification.
                    </div>

                    <!-- Add password change form here if needed -->
                    <div class="text-center">
                        <button class="btn btn-outline-warning" disabled title="Coming soon">
                            <i class="bi bi-key me-2"></i>
                            Change Password
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body text-center">
                <div class="mb-3">
                    <div class="avatar-placeholder rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center"
                         style="width: 100px; height: 100px; font-size: 2.5rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                </div>
                <h5>@username</h5>
                <p class="text-muted">System Administrator</p>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-primary" disabled title="Coming soon">
                        <i class="bi bi-camera me-2"></i>
                        Upload Photo
                    </button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0">Account Security</h6>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Last Login
                        <span class="text-muted">Today</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Account Status
                        <span class="badge bg-success">Active</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        Role Permissions
                        <span class="badge bg-primary">Full Access</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@code {
    private class UpdateProfileDto
    {
        public string Email { get; set; } = string.Empty;
        public string PhoneNumber { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Address { get; set; } = string.Empty;
    }

    private string username = string.Empty;
    private string role = string.Empty;
    private string userId = string.Empty;
    private UpdateProfileDto updateDto = new();
    private bool isLoading = true;
    private bool isUpdating = false;
    private string updateMessage = string.Empty;
    private bool updateSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        var userRole = await AuthService.GetRole();
        if (userRole != "Admin")
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadProfileData();
    }

    private async Task LoadProfileData()
    {
        try
        {
            username = await AuthService.GetUsername() ?? string.Empty;
            role = await AuthService.GetRole() ?? string.Empty;
            userId = await AuthService.GetUserId() ?? string.Empty;

            // TODO: Load additional profile data from API
            // You'll need to create an AdminService for this

            // Set initial values for update form
            updateDto = new UpdateProfileDto
            {
                Email = username, // Use username as email for now
                PhoneNumber = "",
                FullName = "Administrator",
                Address = ""
            };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUpdate()
    {
        isUpdating = true;
        updateMessage = string.Empty;
        updateSuccess = false;

        try
        {
            // TODO: Call API to update admin profile
            // You'll need to create an AdminService for this

            // Simulate API call
            await Task.Delay(1000);

            updateSuccess = true;
            updateMessage = "Profile updated successfully!";

            // Reload profile data
            await LoadProfileData();
        }
        catch (Exception ex)
        {
            updateSuccess = false;
            updateMessage = $"Error updating profile: {ex.Message}";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private void ResetForm()
    {
        updateDto = new UpdateProfileDto
        {
            Email = username,
            PhoneNumber = "",
            FullName = "Administrator",
            Address = ""
        };
        updateMessage = string.Empty;
    }
}