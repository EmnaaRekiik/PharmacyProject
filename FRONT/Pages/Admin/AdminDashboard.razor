@page "/admin/dashboard"
@using pharmacy
@inject FRONT.Services.AuthServices AuthService
@inject FRONT.Services.PharmacistServices PharmacistService
@inject FRONT.Services.MedicationServices MedicationService
@inject FRONT.Services.DispensedMedicationServices DispensedService
@inject NavigationManager Navigation

<h3>Admin Dashboard</h3>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading dashboard data...</p>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Pharmacists Card -->
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Pharmacists</h5>
                            <h2 class="card-text">@pharmacistCount</h2>
                        </div>
                        <span class="bi bi-person-badge" style="font-size: 2rem;"></span>
                    </div>
                    <button class="btn btn-light btn-sm mt-3 w-100" @onclick="NavigateToPharmacists">
                        <i class="bi bi-arrow-right me-1"></i> Manage Pharmacists
                    </button>
                </div>
            </div>
        </div>

        <!-- Medications Card -->
        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Medications</h5>
                            <h2 class="card-text">@medicationCount</h2>
                        </div>
                        <span class="bi bi-capsule" style="font-size: 2rem;"></span>
                    </div>
                    <button class="btn btn-light btn-sm mt-3 w-100" @onclick="NavigateToMedications">
                        <i class="bi bi-arrow-right me-1"></i> Manage Medications
                    </button>
                </div>
            </div>
        </div>

        <!-- Low Stock Card -->
        <div class="col-md-3">
            <div class="card text-white bg-warning shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Low Stock</h5>
                            <h2 class="card-text">@lowStockCount</h2>
                        </div>
                        <span class="bi bi-exclamation-triangle" style="font-size: 2rem;"></span>
                    </div>
                    <button class="btn btn-light btn-sm mt-3 w-100" @onclick="NavigateToLowStock">
                        <i class="bi bi-arrow-right me-1"></i> View Details
                    </button>
                </div>
            </div>
        </div>

        <!-- Dispensed History Card -->
        <div class="col-md-3">
            <div class="card text-white bg-info shadow">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Dispensed Today</h5>
                            <h2 class="card-text">@dispensedTodayCount</h2>
                        </div>
                        <span class="bi bi-clipboard-check" style="font-size: 2rem;"></span>
                    </div>
                    <button class="btn btn-light btn-sm mt-3 w-100" @onclick="NavigateToDispensed">
                        <i class="bi bi-arrow-right me-1"></i> View History
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">System Overview</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Total Pharmacists
                                    <span class="badge bg-primary rounded-pill">@pharmacistCount</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Total Medications
                                    <span class="badge bg-success rounded-pill">@medicationCount</span>
                                </li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Low Stock Medications
                                    <span class="badge bg-warning rounded-pill">@lowStockCount</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Dispensed Today
                                    <span class="badge bg-info rounded-pill">@dispensedTodayCount</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-3">
                        <button class="btn btn-primary" @onclick="NavigateToCreatePharmacist">
                            <i class="bi bi-person-plus me-2"></i> Add New Pharmacist
                        </button>
                        <button class="btn btn-success" @onclick="NavigateToCreateMedication">
                            <i class="bi bi-capsule me-2"></i> Add New Medication
                        </button>
                        <button class="btn btn-info" @onclick="NavigateToDispensed">
                            <i class="bi bi-clipboard-data me-2"></i> View Dispensed History
                        </button>
                        <button class="btn btn-secondary" @onclick="NavigateToProfile">
                            <i class="bi bi-gear me-2"></i> Update Profile
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private int pharmacistCount = 0;
    private int medicationCount = 0;
    private int lowStockCount = 0;
    private int dispensedTodayCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var role = await AuthService.GetRole();
            if (role != "Admin")
            {
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDashboardData()
    {
        try
        {
            // Load pharmacists
            var pharmacists = await PharmacistService.GetPharmacistsAsync();
            pharmacistCount = pharmacists?.Count ?? 0;

            // Load medications
            var medications = await MedicationService.GetMedicationsAsync();
            medicationCount = medications?.Count ?? 0;
            lowStockCount = medications?.Count(m => m.StockQuantity < 10) ?? 0;

            // Load dispensed medications
            var dispensedMedications = await DispensedService.GetDispensedMedicationsAsync();
            dispensedTodayCount = dispensedMedications?
                .Count(d => d.DeliveryDate.Date == DateTime.Today) ?? 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    private void NavigateToPharmacists() => Navigation.NavigateTo("/admin/pharmacists");
    private void NavigateToMedications() => Navigation.NavigateTo("/admin/medications");
    private void NavigateToLowStock() => Navigation.NavigateTo("/admin/medications?filter=lowstock");
    private void NavigateToDispensed() => Navigation.NavigateTo("/admin/dispensed");
    private void NavigateToCreatePharmacist() => Navigation.NavigateTo("/admin/pharmacists/create");
    private void NavigateToCreateMedication() => Navigation.NavigateTo("/admin/medications/create");
    private void NavigateToProfile() => Navigation.NavigateTo("/admin/profile");
}