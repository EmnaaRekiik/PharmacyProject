  "components": {
    "schemas": {
      "CreatePharmacistDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "pharmacistName": {
            "type": "string",
            "nullable": true
          },
          "pharmacyName": {
            "type": "string",
            "nullable": true
          },
          "licenseNumber": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePrescriptionMedicationDto": {
        "type": "object",
        "properties": {
          "prescriptionId": {
            "type": "integer",
            "format": "int32"
          },
          "medicationId": {
            "type": "integer",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "dosageInstructions": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DispensedMedication": {
        "required": [
          "deliveryDate",
          "medicationId",
          "pharmacistId",
          "prescriptionId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "dispensedId": {
            "type": "integer",
            "format": "int32"
          },
          "prescriptionId": {
            "type": "integer",
            "format": "int32"
          },
          "prescription": {
            "$ref": "#/components/schemas/Prescription"
          },
          "medicationId": {
            "type": "integer",
            "format": "int32"
          },
          "medication": {
            "$ref": "#/components/schemas/Medication"
          },
          "pharmacistId": {
            "type": "integer",
            "format": "int32"
          },
          "pharmacist": {
            "$ref": "#/components/schemas/Pharmacist"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "deliveryDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "LoginDTO": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Medication": {
        "required": [
          "name",
          "price",
          "stockQuantity"
        ],
        "type": "object",
        "properties": {
          "medicationId": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "stockQuantity": {
            "type": "integer",
            "format": "int32"
          }
        },
